---
import Carousel from "./Carousel.astro";

const text = await import("../data/texts/04archive.md");
const { title, description, images } = text.frontmatter;
---

<section id="archivo" class="archive">
  <div class="archive-container">
    <div class="archive-header">
      <h2 class="archive-title">{title}</h2>
      <p class="archive-description">{description}</p>
    </div>

    <Carousel label="carrusel del archivo">
      {
        images.map((img, i) => (
          <div class="slide">
            <figure class="archive-item">
              <img
                src={img.src}
                alt={img.alt}
                loading={i === 0 ? "eager" : "lazy"}
                width="1200"
                height="800"
              />
            </figure>
          </div>
        ))
      }
    </Carousel>
  </div>
</section>

<style>
  .archive {
    padding: 6rem 2rem;
    background: var(--color-bg);
  }

  .archive-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .archive-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .archive-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .archive-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .archive-item {
    margin: 0 auto;
    max-width: 820px;
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .archive-item img {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 520px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .archive {
      padding: 4rem 1rem;
    }

    .archive-item img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
