---
const text = await import("../data/texts/10footer.md");
const { logo, name, school, links, email, instagram, copyright } = text.frontmatter;
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <span class="footer-name">{name}</span>
      <span class="footer-school">{school}</span>
    </div>

    <div class="footer-links">
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>

    <div class="footer-contact">
      <a href={`mailto:${email}`}>
        {email}
      </a>
      <a
        href={instagram}
        class="footer-instagram"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram del Taller de Patrimonio"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
        </svg>
      </a>
    </div>

    <p class="footer-copy">
      © {new Date().getFullYear()}
      {name}
      {school}. {copyright}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: 3rem 2rem;
    background: #1a1a1a;
    color: #999;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-logo {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .footer-name {
    font-size: 1rem;
    font-weight: 600;
    color: white;
  }

  .footer-school {
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    color: #999;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-accent-yellow);
  }

  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-contact a {
    color: #999;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-contact a:hover {
    color: white;
  }

  .footer-instagram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #999;
    transition: color 0.2s;
  }

  .footer-instagram svg {
    width: 22px;
    height: 22px;
  }

  .footer-instagram:hover {
    color: var(--color-accent-yellow);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: #666;
    margin-top: 1rem;
  }

  @media (max-width: 1000px) {
    .footer-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem 2rem;
    }
  }
</style>
