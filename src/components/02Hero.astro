---
const text = await import("../data/texts/02hero.md");
const { message, tag, title, highlight, subtitle, buttons } = text.frontmatter;
---

<section class="hero">
  <div class="hero-content">
    <p class="hero-tag">{tag}</p>
    <h1 class="hero-title">
      {title}
      <span class="highlight"> {highlight}</span>
    </h1>
    <p class="hero-tag-low">{message}</p>
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions">
      {
        buttons.map((btn) => (
          <a href={btn.href} class={`btn btn-${btn.variant}`}>
            {btn.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 2rem 4rem;
    position: relative;
    background-image: url("/images/header.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.3) 20%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0.7) 70%,
      rgba(0, 0, 0, 0.6) 90%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 1;
  }

  .hero-content {
    max-width: 700px;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .hero-tag {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #fbe151;
    margin-bottom: 1.5rem;
  }

  .hero-tag-low {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-weight: 600;
    font-style: italic;
    color: #fbe151;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--color-text-hero);
  }

  .highlight {
    color: var(--color-accent-hero);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text-hero);
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-accent-red);
    color: white;
  }

  .btn-primary:hover {
    background: #c4151f;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text-hero);
    border: 1.5px solid var(--color-border);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent-hero);
    color: var(--color-accent-hero);
  }
</style>
