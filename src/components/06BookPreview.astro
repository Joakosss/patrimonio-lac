---
import Carousel from "./Carousel.astro";

const text = await import("../data/texts/06book.md");
const { publications } = text.frontmatter;
---

<section id="publicaciones" class="book">
  <div class="book-container">
    <Carousel label="carrusel de publicaciones">
      {
        publications.map((pub) =>
          pub.comingSoon ? (
            <div class="slide slide-soon">
              <p class="soon-text">{pub.text}</p>
            </div>
          ) : (
            <div class="slide">
              <div class="book-layout">
                <div class="book-cover">
                  {pub.portada ? (
                    <img
                      src={pub.portada}
                      alt={`Portada de ${pub.title}`}
                      class="cover-photo"
                      loading="lazy"
                    />
                  ) : (
                    <div class="cover-placeholder">
                      <span class="cover-icon">{pub.coverIcon ?? "📖"}</span>
                      <span class="cover-text">
                        {pub.coverText ?? "En preparación"}
                      </span>
                    </div>
                  )}
                </div>

                <div class="book-info">
                  <h2 class="book-title">{pub.title}</h2>
                  <p class="book-authors">{pub.authors}</p>
                  <p class="book-description">{pub.description}</p>
                  <div class="book-meta">
                    {pub.meta.map((item) => (
                      <div class="meta-item">
                        <span class="meta-label">{item.label}</span>
                        <span class="meta-value">{item.value}</span>
                      </div>
                    ))}
                  </div>
                  {pub.btn && pub.btnRef && (
                    <a
                      href={pub.btnRef}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="book-button"
                    >
                      {pub.btn}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ),
        )
      }
    </Carousel>
  </div>
</section>

<style>
  .book {
    padding: 6rem 2rem;
    background: var(--color-bg);
  }

  .book-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Diapositiva 1: publicación */
  .book-layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 4rem;
    align-items: center;
  }

  .cover-placeholder {
    width: 100%;
    aspect-ratio: 2/3;
    background: linear-gradient(
      135deg,
      var(--color-accent-red) 0%,
      #b8121b 100%
    );
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    box-shadow: 0 8px 32px rgba(229, 26, 37, 0.2);
  }

  .cover-icon {
    font-size: 3rem;
  }

  .cover-photo {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(229, 26, 37, 0.2);
    display: block;
  }

  .cover-text {
    color: white;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .book-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .book-authors {
    font-size: 0.95rem;
    color: var(--color-accent-red);
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .book-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .book-meta {
    display: flex;
    gap: 2rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .book-button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.75rem 1.75rem;
    background: var(--color-accent-red);
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .book-button:hover {
    background: #b8121b;
    transform: translateY(-2px);
  }

  /* Diapositiva 2: próximamente */
  .slide-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
  }

  .soon-text {
    font-size: clamp(3rem, 10vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1.1;
    text-align: center;
    background: linear-gradient(
      135deg,
      var(--color-accent-red) 0%,
      #b8121b 60%,
      var(--color-accent-yellow) 130%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  @media (max-width: 768px) {
    .book-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .cover-placeholder {
      max-width: 250px;
      margin: 0 auto;
    }

    .cover-photo {
      max-width: 250px;
      margin: 0 auto;
    }

    .book-meta {
      justify-content: center;
    }

    .book-info .book-button {
      display: block;
      max-width: max-content;
      margin-left: auto;
      margin-right: auto;
    }

    .slide-soon {
      padding: 3rem 1rem;
    }
  }
</style>
