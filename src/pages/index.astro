---
import LayoutBase from "../layouts/LayoutBase.astro";
import Header from "../components/01Header.astro";
import Hero from "../components/02Hero.astro";
import Team from "../components/03Team.astro";
import Archive from "../components/04Archive.astro";
import Mascot from "../components/05Mascot.astro";
import BookPreview from "../components/06BookPreview.astro";
import InstagramZone from "../components/07InstagramZone.astro";
import About from "../components/08About.astro";
import Contact from "../components/09Contact.astro";
import Footer from "../components/10Footer.astro";
---

<LayoutBase
  title="Taller de Patrimonio Luis Arrieta Cañas"
  description="Taller de patrimonio del Liceo Luis Arrieta Cañas. Investigamos, preservamos y compartimos la historia de nuestro liceo a través de fotografías, testimonios y publicaciones."
>
  <Header />
  <main>
    <Hero />
    <Team />
    <Archive />
    <Mascot />
    <BookPreview />
    <InstagramZone />
    <About />
    <Contact />
  </main>
  <Footer />
</LayoutBase>
